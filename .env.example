# ==========================================
# Notification mode
# ==========================================
# Set to true to use email instead of Discord for alerts.
USE_EMAIL=false

# ==========================================
# Discord configuration
# Only required when USE_EMAIL=false
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_channel_id_here
LOG_CHANNEL_ID=your_log_channel_id_here
# Discord User ID to ping (optional)
USER_ID_TO_PING=your_user_id_here

# ==========================================
# Email configuration
# Only required when USE_EMAIL=true
# Note: For Gmail, use an App Password (not your regular password)
# You can create an App Password at https://myaccount.google.com/apppasswords
# RECIPIENT_EMAILS accepts multiple addresses separated by commas.
# ==========================================
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here
RECIPIENT_EMAILS=first_recipient@example.com,second_recipient@example.com

# ==========================================
# Polling / retry timing
# ==========================================
COURSE_POLLING_SECONDS=10
SESSION_RETRY_SECONDS=3

# ==========================================
# Polytechnique login
# ==========================================
DOSSIER_USER=your_username_here
DOSSIER_PASS=your_password_here
BIRTH=YYYYMMDD

# ==========================================
# Courses to monitor
# Format: SIGLE + groupe + type (T = théorie, L = labo)
# Example: LOG244001T, LOG244002L
# ==========================================
COURSES=LOG244001T,LOG244002L